{
  "ConnectionStrings": {
    "SpeedSagaDB": "SET_VIA_ENV_ConnectionStrings__SpeedSagaDB"
  },
  "Jwt": {
    "Key": "SET_VIA_ENV_Jwt__Key",
    "Issuer": "SpeedSagaAPI",
    "Audience": "SpeedSagaApp",
    "ExpireHours": 72
  },
  "Razorpay": {
    "KeyId": "SET_VIA_ENV_Razorpay__KeyId",
    "KeySecret": "SET_VIA_ENV_Razorpay__KeySecret",
    "WebhookSecret": "SET_VIA_ENV_Razorpay__WebhookSecret"
  },
  "Messaging": {
    "SmsProvider": "Msg91",
    "EmailProvider": "Smtp"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
